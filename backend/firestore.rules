rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================================================
     * AUTH HELPERS
     * ========================================================= */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }

    function isCustomerForBooking(bookingId) {
      return isSignedIn()
        && get(
          /databases/$(database)/documents/bookings/$(bookingId)
        ).data.customerId == request.auth.uid;
    }

    function isBookingParticipant() {
      return isSignedIn()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.maidId == request.auth.uid
          || resource.data.winningMaidId == request.auth.uid
        );
    }

    function validMaidRequestResponse() {
      return request.resource.data.response == 'accepted'
        || request.resource.data.response == 'rejected';
    }


    /* =========================================================
     * CUSTOMER / USER PROFILE
     * users/{userId}
     * ========================================================= */

    match /users/{userId} {
      /*
       * Customer can only access their own profile.
       * Backend/Admin SDK is unaffected by these rules.
       */
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'userId',
          'role',
          'phoneNumber',
          'name',
          'address',
          'createdAt',
          'updatedAt'
        ]);

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'userId',
            'role',
            'phoneNumber',
            'name',
            'address',
            'updatedAt'
          ]);

      allow delete: if false;
    }


    /* =========================================================
     * HELP / MAID PROFILE
     * maids/{maidId}
     *
     * Pilot behavior:
     * - Verification is intentionally skipped.
     * - Onboarding creates the Help as "verified".
     * - Help starts with isAvailableNow == false.
     * - Only the owner can read the profile.
     * - Backend/Admin SDK can read all maid documents.
     * ========================================================= */

    match /maids/{maidId} {
      allow read: if isOwner(maidId);

      allow create: if isOwner(maidId)
        && request.resource.data.maidId == request.auth.uid
        && request.resource.data.role == 'maid'
        && request.resource.data.verificationStatus == 'verified'
        && request.resource.data.isAvailableNow == false
        && request.resource.data.keys().hasOnly([
          'maidId',
          'role',
          'name',
          'phoneNumber',
          'alternatePhoneNumber',
          'gender',
          'dateOfBirth',
          'emergencyContact',
          'photoUrl',
          'idDocumentUrl',
          'idDocumentName',
          'idDocumentType',
          'serviceCategories',
          'serviceArea',
          'verificationStatus',
          'isAvailableNow',
          'availabilitySlots',
          'availabilityOverride',
          'fcmTokens',
          'createdAt',
          'updatedAt'
        ]);

      allow update: if isOwner(maidId)
        && request.resource.data.maidId == request.auth.uid
        && request.resource.data.role == 'maid'
        /*
         * The client must never be able to change verification
         * status. Backend/Admin controls that field.
         */
        && request.resource.data.verificationStatus == resource.data.verificationStatus
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'gender',
            'phoneNumber',
            'alternatePhoneNumber',
            'dateOfBirth',
            'emergencyContact',
            'photoUrl',
            'idDocumentUrl',
            'idDocumentName',
            'idDocumentType',
            'serviceCategories',
            'serviceArea',
            'availabilitySlots',
            'availabilityOverride',
            'isAvailableNow',
            'currentLocation',
            'fcmTokens',
            'updatedAt'
          ]);

      allow delete: if false;
    }


    /* =========================================================
     * CATEGORIES
     * categories/{categoryId}
     * ========================================================= */

    match /categories/{categoryId} {
      /*
       * Signed-in users can read service/category/pricing data.
       * Clients cannot modify pricing or category definitions.
       */
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }


    /* =========================================================
     * BOOKINGS
     * bookings/{bookingId}
     *
     * Booking creation and all lifecycle mutations are backend-only.
     * Client only receives participant-scoped read access.
     * ========================================================= */

    match /bookings/{bookingId} {
      allow create: if false;

      allow read: if isBookingParticipant();

      allow update, delete: if false;


      /* =======================================================
       * MAID BOOKING REQUEST
       * bookings/{bookingId}/maidRequests/{maidId}
       *
       * The Help may read/respond only to their own request.
       * ======================================================= */

      match /maidRequests/{requestMaidId} {
        allow read: if isSignedIn()
          && resource.data.maidId == request.auth.uid;

        allow create: if false;

        allow update: if isSignedIn()
          && resource.data.maidId == request.auth.uid
          && request.resource.data.maidId == request.auth.uid
          && resource.data.response == 'pending'
          && validMaidRequestResponse()
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'response',
              'responseReason',
              'updatedAt'
            ]);

        allow delete: if false;
      }


      /* =======================================================
       * CUSTOMER START OTP
       * bookings/{bookingId}/customerSecrets/{secretId}
       *
       * Plaintext OTP is customer-only.
       * Client cannot create/update/delete it.
       * Backend/Admin SDK writes it.
       * ======================================================= */

      match /customerSecrets/{secretId} {
        allow read: if isCustomerForBooking(bookingId);

        allow create, update, delete: if false;
      }
    }


    /* =========================================================
     * COLLECTION-GROUP ACCESS FOR maidRequests
     *
     * Required by the Help app listener:
     *
     * collectionGroup("maidRequests")
     *   .where("maidId", "==", currentUid)
     *   .where("response", "==", "pending")
     *
     * Important:
     * Do NOT require requestMaidId == request.auth.uid here.
     * The query is authorized using the stored maidId field.
     * ========================================================= */

    match /{path=**}/maidRequests/{requestMaidId} {
      allow read: if isSignedIn()
        && resource.data.maidId == request.auth.uid;

      allow create: if false;

      allow update: if isSignedIn()
        && resource.data.maidId == request.auth.uid
        && request.resource.data.maidId == request.auth.uid
        && resource.data.response == 'pending'
        && validMaidRequestResponse()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'response',
            'responseReason',
            'updatedAt'
          ]);

      allow delete: if false;
    }


    /* =========================================================
     * DEFAULT DENY
     * ========================================================= */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
