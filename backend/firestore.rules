rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId;
    }

    function isCustomerForBooking(bookingId) {
      return isSignedIn()
        && get(
          /databases/$(database)/documents/bookings/$(bookingId)
        ).data.customerId == request.auth.uid;
    }

    function isBookingParticipant() {
      return isSignedIn()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.maidId == request.auth.uid
          || resource.data.winningMaidId == request.auth.uid
        );
    }

    function validMaidRequestResponse() {
      return request.resource.data.response == 'accepted'
        || request.resource.data.response == 'rejected';
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.role == 'customer'
        && request.resource.data.keys().hasOnly([
          'userId',
          'role',
          'phoneNumber',
          'name',
          'gender',
          'photoUrl',
          'address',
          'createdAt',
          'updatedAt',
          'fcmTokens'
        ]);

      allow update: if isOwner(userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.role == 'customer'
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'userId',
            'role',
            'phoneNumber',
            'name',
            'gender',
            'photoUrl',
            'address',
            'createdAt',
            'updatedAt',
            'fcmTokens'
          ]);

      allow delete: if false;
    }

    match /maids/{maidId} {
      allow read: if isOwner(maidId);

      allow create: if isOwner(maidId)
        && request.resource.data.maidId == request.auth.uid
        && request.resource.data.role == 'maid'
        && request.resource.data.verificationStatus == 'verified'
        && request.resource.data.isAvailableNow == false
        && request.resource.data.keys().hasOnly([
          'maidId',
          'role',
          'name',
          'phoneNumber',
          'alternatePhoneNumber',
          'gender',
          'dateOfBirth',
          'emergencyContact',
          'photoUrl',
          'idDocumentUrl',
          'idDocumentName',
          'idDocumentType',
          'serviceCategories',
          'serviceArea',
          'verificationStatus',
          'isAvailableNow',
          'availabilitySlots',
          'availabilityOverride',
          'currentLocation',
          'lastAssignedAt',
          'fcmTokens',
          'createdAt',
          'updatedAt'
        ]);

      allow update: if isOwner(maidId)
        && request.resource.data.maidId == request.auth.uid
        && request.resource.data.role == 'maid'
        && request.resource.data.verificationStatus == resource.data.verificationStatus
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'gender',
            'phoneNumber',
            'alternatePhoneNumber',
            'dateOfBirth',
            'emergencyContact',
            'photoUrl',
            'idDocumentUrl',
            'idDocumentName',
            'idDocumentType',
            'serviceCategories',
            'serviceArea',
            'availabilitySlots',
            'availabilityOverride',
            'isAvailableNow',
            'currentLocation',
            'lastAssignedAt',
            'fcmTokens',
            'updatedAt'
          ]);

      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /bookings/{bookingId} {
      allow create: if false;
      allow update, delete: if false;
      allow read: if isBookingParticipant();

      match /maidRequests/{requestMaidId} {
        allow read: if isSignedIn()
          && resource.data.maidId == request.auth.uid;

        allow create: if false;

        allow update: if isSignedIn()
          && resource.data.maidId == request.auth.uid
          && request.resource.data.maidId == request.auth.uid
          && resource.data.response == 'pending'
          && validMaidRequestResponse()
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'response',
              'responseReason',
              'updatedAt'
            ]);

        allow delete: if false;
      }

      match /customerSecrets/{secretId} {
        allow read: if isCustomerForBooking(bookingId);
        allow create, update, delete: if false;
      }
    }

    match /{path=**}/maidRequests/{requestMaidId} {
      allow read: if isSignedIn()
        && resource.data.maidId == request.auth.uid;

      allow create: if false;

      allow update: if isSignedIn()
        && resource.data.maidId == request.auth.uid
        && request.resource.data.maidId == request.auth.uid
        && resource.data.response == 'pending'
        && validMaidRequestResponse()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'response',
            'responseReason',
            'updatedAt'
          ]);

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
